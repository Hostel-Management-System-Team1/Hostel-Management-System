# Copy to .env (never commit .env). All values are optional for local development.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL connection. These are the defaults used when the variables are not set.
POSTGRES_DB=hms
POSTGRES_USER=hms
POSTGRES_PASSWORD=hms
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email notifications (console backend is safe for local development).
# For SMTP, set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and configure these.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=hostel-management@localhost
