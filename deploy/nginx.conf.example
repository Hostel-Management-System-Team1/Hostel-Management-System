# Example reverse proxy for the Hostel Management System (HMS-SR-001, TC-SEC-01).
# TLS terminates here; Django runs behind it with HMS_BEHIND_PROXY=true.

# Rate limiting (SAD 3.9, denial of service): at most 10 requests a second per address, with a
# small burst, and a tighter limit on the sign-in page to slow password guessing.
limit_req_zone $binary_remote_addr zone=hms_general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=hms_login:10m rate=5r/m;

server {
    listen 80;
    server_name hostel.example.edu;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name hostel.example.edu;

    ssl_certificate     /etc/ssl/hms/fullchain.pem;
    ssl_certificate_key /etc/ssl/hms/privkey.pem;

    # No connection below TLS 1.2, and only strong AEAD cipher suites for 1.2.
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    location /static/ { alias /srv/hms/staticfiles/; }
    location /media/  { alias /srv/hms/media/; }

    location /accounts/login/ {
        limit_req zone=hms_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        limit_req zone=hms_general burst=40 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
